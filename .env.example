ANTHROPIC_API_KEY=sk-ant-...
SERVER_IP=192.168.1.x
SERVER_USER=yourusername
JELLYFIN_URL=http://192.168.1.x:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TEMP_DIR=/tmp/ai-ripper
MEDIA_ROOT=/media
# Phase 3 approval gate (--approve). Optional: leave blank to keep the old
# auto-transfer behavior. Create a Discord bot, copy its token, and put the
# target channel's id here (right-click channel → Copy Channel ID; needs
# Developer Mode on). Invite the bot with Send Messages + Embed Links.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# How long (seconds) to wait for the Approve/Fix tap before holding the files.
APPROVAL_TIMEOUT_SECS=1800
# Episode-guide source for --content-id. TMDB has every season's episode list
# (even ones you haven't ripped yet), so content-ID works on a brand-new season;
# Jellyfin only knows seasons already in your library. Free key: themoviedb.org →
# create account → Settings → API → API Key (v3 auth). Blank ⇒ fall back to Jellyfin.
TMDB_API_KEY=
