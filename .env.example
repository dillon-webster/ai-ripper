ANTHROPIC_API_KEY=sk-ant-...
SERVER_IP=192.168.1.x
SERVER_USER=yourusername
JELLYFIN_URL=http://192.168.1.x:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
TEMP_DIR=/tmp/ai-ripper
MEDIA_ROOT=/media
# Phase 3 approval gate (--approve). Optional: leave blank to keep the old
# auto-transfer behavior. Create a Discord bot, copy its token, and put the
# target channel's id here (right-click channel → Copy Channel ID; needs
# Developer Mode on). Invite the bot with Send Messages + Embed Links.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Optional: your Discord user ID to @mention in the approval message so it pushes
# to your phone even while you're active on desktop (Discord otherwise suppresses
# the mobile push). Right-click your name → Copy User ID (needs Developer Mode).
DISCORD_MENTION_USER_ID=
# How long (seconds) to wait for the Approve/Fix tap before holding the files.
APPROVAL_TIMEOUT_SECS=1800
# Web review UI (--review-ui): hand-curate the episode mapping in the browser
# before transfer. Served from the rip-box itself; reach it over your tailnet
# (Tailscale) — never port-forward this or enable Funnel on it.
REVIEW_UI_PORT=8765
# How long (seconds) to wait for the curated mapping before holding the files.
REVIEW_UI_TIMEOUT_SECS=1800
# Stills per title in the filmstrip. More frames = easier to verify an episode,
# at the cost of more ffmpeg grabs when a card scrolls into view.
REVIEW_UI_THUMBS_PER_TITLE=12
# Host to advertise in the review link (logged + sent to Discord). Blank ⇒ the
# box's Tailscale IP when available (link works from your phone/laptop anywhere,
# as long as the device is on the tailnet), else the LAN hostname (home only).
# Set to e.g. ripbox.tail1234.ts.net for a stable MagicDNS name.
REVIEW_UI_ADVERTISE_HOST=
# Episode-guide source for --content-id. TMDB has every season's episode list
# (even ones you haven't ripped yet), so content-ID works on a brand-new season;
# Jellyfin only knows seasons already in your library. Free key: themoviedb.org →
# create account → Settings → API → API Key (v3 auth). Blank ⇒ fall back to Jellyfin.
TMDB_API_KEY=
